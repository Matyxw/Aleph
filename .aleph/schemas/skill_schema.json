{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlephAgentSkillSchema",
  "type": "object",
  "required": [
    "frontmatter",
    "sections"
  ],
  "properties": {
    "frontmatter": {
      "type": "object",
      "required": [
        "name",
        "description",
        "allowed-tools",
        "version",
        "epistemic-status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 25,
          "maxLength": 300
        },
        "allowed-tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "epistemic-status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "PROVISIONAL",
            "DEPRECATED"
          ]
        },
        "author": {
          "type": "string"
        }
      }
    },
    "sections": {
      "type": "object",
      "required": [
        "Objetivo",
        "Precondiciones y Entorno",
        "Pasos de Ejecución",
        "Criterios de Éxito Globales",
        "Reglas Duras",
        "Checkpoint Humano",
        "Fallos Conocidos y Mitigación"
      ]
    }
  }
}