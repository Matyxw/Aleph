# syntax=docker/dockerfile:1
FROM python:3.12-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip \
    && pip install \
      "pydantic>=1.10.0" \
      "numpy>=1.24.0" \
      "PyYAML>=6.0" \
      "starlette>=0.41.0" \
      "uvicorn>=0.32.0" \
      "PyJWT[crypto]>=2.9.0" \
      "cryptography>=43.0.0" \
      "httpx>=0.27.0"


FROM python:3.12-slim AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    ALEPH_MCP_AUTH_MODE=oauth2_jwt \
    ALEPH_MCP_PROFILE=remote_sovereign \
    PORT=8080

RUN groupadd --gid 10001 aleph \
    && useradd --uid 10001 --gid 10001 --home-dir /tmp --shell /sbin/nologin --no-create-home aleph

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=root:root aleph_cli.py /app/aleph_cli.py
COPY --chown=root:root aleph_core /app/aleph_core
COPY --chown=root:root .aleph /app/.aleph

USER 10001:10001

EXPOSE 8080

CMD ["sh", "-c", "exec python -B /app/aleph_cli.py mcp-prod-serve --host 0.0.0.0 --port ${PORT:-8080}"]
